# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every value below is a placeholder.

# ── V2 (radar/) ──────────────────────────────────────────────────────────────

# GitHub token. Optional but strongly recommended: without it the API allows
# 60 requests/hour, with it 5,000. A fine-grained token with read-only access
# to public repositories is enough. radar/ reads this from the shell
# environment first, then from this file.
GITHUB_TOKEN=your_github_token_here

# Where runtime data lives. Default: ./data (gitignored).
# RADAR_DATA_DIR=/absolute/path/to/private/data

# Optional finer-grained overrides (defaults sit under the data directory).
# RADAR_DB=/absolute/path/to/radar.db
# RADAR_DASHBOARD=/absolute/path/to/dashboard.html

# Set to 1 to print full tracebacks for repos that fail during a scan.
# RADAR_TRACE=1

# ── V1 (legacy/v1/) — only needed to run the archived implementation ─────────
# V1 reads GITHUB_TOKEN from this file, but reads the two values below from
# the shell environment only: `export` them before running a V1 script.

# The Google Sheet V1 used as its datastore (the ID from the sheet's URL).
# RADAR_SHEET_ID=your_google_sheet_id_here

# Path to a Google service-account key with access to that sheet.
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account-key.json
